{
  "name": "dsh-wechat-mcp",
  "version": "0.3.0",
  "description": "DeepSeek Harness (DSH) 插件：通过官方 MCP 客户端桥接本机微信桌面自动化服务（Windows）。",
  "type": "module",
  "license": "MPL-2.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "bin/",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "stage-runtime": "node scripts/stage-runtime.mjs",
    "prepack": "node scripts/stage-runtime.mjs",
    "verify": "npx --yes dsh-plugin-standard .",
    "pack": "npm pack"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "wechat"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CheserEri/wechat-mcp.git",
    "directory": "dsh-plugin"
  },
  "homepage": "https://github.com/CheserEri/wechat-mcp",
  "bugs": {
    "url": "https://github.com/CheserEri/wechat-mcp/issues"
  },
  "os": [
    "win32"
  ]
}